# Use a disposable local/test database. Never put production credentials here.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/task_manager_dev
# Replace with at least 32 randomly generated characters before starting the server.
JWT_SECRET=
JWT_EXPIRES_IN=7200
# Comma-separated exact allowed origins.
CORS_ORIGIN=http://localhost:3000
# These NEXT_PUBLIC values are visible in the browser; rebuild after changing them.
NEXT_PUBLIC_API_MODE=http
NEXT_PUBLIC_API_BASE_URL=/api
