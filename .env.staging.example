# Reference template only: configure the GitHub staging environment and Render
# dashboard directly. Never populate and commit credentials in this file.
# GitHub staging environment secrets:
RENDER_API_DEPLOY_HOOK_URL=
RENDER_WEB_DEPLOY_HOOK_URL=
RENDER_API_TOKEN=
# GitHub staging environment variables:
STAGING_DEPLOY_ENABLED=false
STAGING_API_URL=https://your-api-service.onrender.com
STAGING_WEB_URL=https://your-web-service.onrender.com
# Render API service environment:
MONGODB_URI=
JWT_SECRET=
CORS_ORIGIN=https://your-web-service.onrender.com
# Render web service environment (public at build time):
NEXT_PUBLIC_API_MODE=http
NEXT_PUBLIC_API_BASE_URL=https://your-api-service.onrender.com/api
