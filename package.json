{
  "name": "se-miniproject",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "test": "npm --workspace backend test && npm --workspace frontend test",
    "lint": "npm --workspace backend run lint && npm --workspace frontend run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}