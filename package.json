{
  "name": "task-manager",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @task-manager/api run dev",
    "dev:web": "npm --workspace @task-manager/web run dev",
    "build": "npm --workspace @task-manager/web run build",
    "test": "npm --workspace @task-manager/api test && npm --workspace @task-manager/web test",
    "lint": "npm --workspace @task-manager/api run lint && npm --workspace @task-manager/web run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
