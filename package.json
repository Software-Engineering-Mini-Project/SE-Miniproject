{
  "name": "task-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch-path=server server/main.js --dev",
    "build": "next build",
    "start": "node server/main.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed.js --demo-dates",
    "user:role": "node scripts/set-role.js",
    "db:indexes": "node scripts/sync-indexes.js",
    "db:migrate": "node scripts/migrate.js",
    "lint": "eslint .",
    "test": "npm run test:api && npm run test:web",
    "test:api": "node --test \"server/tests/*.test.mjs\"",
    "test:web": "node --test tests/fixtures.test.mjs tests/permissions.test.mjs tests/mock-api.test.mjs && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@number-flow/react": "^0.6.2",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.57.0",
    "mongoose": "^9.11.4",
    "motion": "^14.3.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serverless-http": "^4.0.0",
    "sonner": "^2.0.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.7",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "globals": "^14.0.0",
    "hermes-parser": "^0.25.1",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsconfig-paths": "^4.2.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "hermes-parser": true
  }
}
