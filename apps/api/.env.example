# Local API configuration. Copy to .env and fill in local/test-only values.
PORT=4000
# Use a disposable local/test database. Never put a real URI in this example.
MONGODB_URI=mongodb://127.0.0.1:27017/task_manager_dev
# Replace with at least 32 randomly generated characters before starting the API.
JWT_SECRET=
JWT_EXPIRES_IN=7200
# Comma-separated exact origins; include port 3100 when testing the HTTP E2E suite.
CORS_ORIGIN=http://localhost:3000
