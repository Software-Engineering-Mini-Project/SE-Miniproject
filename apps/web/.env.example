# Base URL of the Express REST API (SAD §4). Agree the final path (/api vs /api/v1) with the backend owner.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# "mock" runs the whole UI against an in-browser mock API seeded from fixtures/ (no backend needed).
# "http" calls the real API at NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_MODE=mock
